// G10 combined CUDA8 dispatcher smoke.
//
// Validates:
//   - CPY_F32
//   - ADD_F32
//   - ADD_SCALAR_F32
//   - MUL_SCALAR_F32
//   - REDUCE_SUM_ROWS_F32
//   - REDUCE_MAX_ROWS_F32
//   - SOFTMAX_ROWS_F32
//   - MUL_MAT_Q8_0xF32_VEC
