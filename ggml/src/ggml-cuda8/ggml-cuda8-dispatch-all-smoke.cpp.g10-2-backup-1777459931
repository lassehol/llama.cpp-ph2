static bool test_scalar(ggml_cuda8_context * ctx, int op, float scalar) {
    std::printf("\n[%s]\n", ggml_cuda8_op_name(op));

    const int rows = 64;
    const int cols = 64;
    const size_t n = (size_t) rows * cols;

    std::vector<float> src(n);
    std::vector<float> dst(n, 0.0f);
    std::vector<float> ref(n);

    for (size_t i = 0; i < n; ++i) {
        src[i] = (float) (i % 97) * 0.03125f - 1.5f;

        if (op == GGML_CUDA8_OP_ADD_SCALAR_F32) {
            ref[i] = src[i] + scalar;
        } else {
            ref[i] = src[i] * scalar;
        }
    }

    ggml_tensor t_src;
    ggml_tensor t_scalar;
    ggml_tensor t_dst;

    setup_f32_matrix_2d(t_src, cols, rows, &src[0]);
    setup_f32_scalar(t_scalar, &scalar);
    setup_f32_matrix_2d(t_dst, cols, rows, &dst[0]);

    if (!ggml_cuda8_dispatch_supported(ctx, op, &t_src, &t_scalar, &t_dst)) {
        std::fprintf(stderr, "%s unsupported\n", ggml_cuda8_op_name(op));
        return false;
    }

    if (ggml_cuda8_dispatch_execute(ctx, op, &t_src, &t_scalar, &t_dst) != 0) {
        std::fprintf(stderr, "%s execute failed\n", ggml_cuda8_op_name(op));
        return false;
    }

    if (!check_close(dst, ref, 1e-6, 1e-6, ggml_cuda8_op_name(op))) {
        return false;
    }

    std::printf("%s PASS\n", ggml_cuda8_op_name(op));
    return true;
}

// ---------------------------------------------------------------------
// Reduce sum/max
// ---------------------------------------------------------------------

static bool test_reduce(ggml_cuda8_context * ctx, int op) {
    std::printf("\n[%s]\n", ggml_cuda8_op_name(op));

    const int rows = 128;
    const int cols = 256;
    const size_t n_src = (size_t) rows * cols;
    const size_t n_dst = (size_t) rows;

    std::vector<float> src(n_src);
    std::vector<float> dst(n_dst, 0.0f);
    std::vector<float> ref(n_dst, 0.0f);

    for (int r = 0; r < rows; ++r) {
        float acc = (op == GGML_CUDA8_OP_REDUCE_MAX_ROWS_F32) ? -FLT_MAX : 0.0f;

        for (int c = 0; c < cols; ++c) {
            const int v = (r * 17 + c * 31 + 7) % 101;
            const float x = ((float) v - 50.0f) * 0.015625f;

            src[(size_t) r * cols + c] = x;

            if (op == GGML_CUDA8_OP_REDUCE_MAX_ROWS_F32) {
                acc = acc > x ? acc : x;
            } else {
                acc += x;
            }
        }

        ref[r] = acc;
    }

    ggml_tensor t_src;
    ggml_tensor t_dst;
    ggml_tensor t_dummy;

    setup_f32_matrix_2d(t_src, cols, rows, &src[0]);
    setup_f32_vector(t_dst, rows, &dst[0]);
    setup_f32_vector(t_dummy, 1, &dst[0]);

    if (!ggml_cuda8_dispatch_supported(ctx, op, &t_src, &t_dummy, &t_dst)) {
        std::fprintf(stderr, "%s unsupported\n", ggml_cuda8_op_name(op));
        return false;
    }

    if (ggml_cuda8_dispatch_execute(ctx, op, &t_src, &t_dummy, &t_dst) != 0) {
        std::fprintf(stderr, "%s execute failed\n", ggml_cuda8_op_name(op));
        return false;
    }

    if (!check_close(dst, ref, 2e-4, 2e-4, ggml_cuda8_op_name(op))) {
        return false;
    }

    std::printf("%s PASS\n", ggml_cuda8_op_name(op));
    return true;
}

// ---------------------------------------------------------------------
// Softmax
// ---------------------------------------------------------------------

static void cpu_softmax_rows(
    const std::vector<float> & src,
    std::vector<float> & ref,
    int rows,
    int cols
) {
    for (int r = 0; r < rows; ++r) {
        const float * row_src = &src[(size_t) r * cols];
        float * row_ref = &ref[(size_t) r * cols];

        float vmax = -FLT_MAX;

        for (int c = 0; c < cols; ++c) {
            vmax = vmax > row_src[c] ? vmax : row_src[c];
        }

        float sum = 0.0f;

        for (int c = 0; c < cols; ++c) {
            const float e = std::exp(row_src[c] - vmax);
            row_ref[c] = e;
            sum += e;
        }

        const float inv_sum = sum > 0.0f ? 1.0f / sum : 0.0f;

        for (int c = 0; c < cols; ++c) {
            row_ref[c] *= inv_sum;
        }
    }
}

static bool test_softmax(ggml_cuda8_context * ctx) {
    std::printf("\n[SOFTMAX_ROWS_F32]\n");

    const int rows = 128;
    const int cols = 256;
    const size_t n = (size_t) rows * cols;

    std::vector<float> src(n);
    std::vector<float> dst(n, 0.0f);
    std::vector<float> ref(n, 0.0f);

    for (int r = 0; r < rows; ++r) {
        for (int c = 0; c < cols; ++c) {
            const int v = (r * 17 + c * 31 + 7) % 101;
            float x = ((float) v - 50.0f) * 0.03125f;

            if ((c % 29) == 0) {
                x += (float) (r % 7) * 0.02f;
            }

            src[(size_t) r * cols + c] = x;
        }
    }

    cpu_softmax_rows(src, ref, rows, cols);

    ggml_tensor t_src;
    ggml_tensor t_dst;
    ggml_tensor t_dummy;

    setup_f32_matrix_2d(t_src, cols, rows, &src[0]);
    setup_f32_matrix_2d(t_dst, cols, rows, &dst[0]);
    setup_f32_matrix_2d(t_dummy, 1, 1, &dst[0]);

    const int op = GGML_CUDA8_OP_SOFTMAX_ROWS_F32;

    if (!ggml_cuda8_dispatch_supported(ctx, op, &t_src, &t_dummy, &t_dst)) {
        std::fprintf(stderr, "SOFTMAX_ROWS_F32 unsupported\n");
        return false;
    }

    if (ggml_cuda8_dispatch_execute(ctx, op, &t_src, &t_dummy, &t_dst) != 0) {
        std::fprintf(stderr, "SOFTMAX_ROWS_F32 execute failed\n");
        return false;
    }

    double max_abs_err = 0.0;
    double max_row_sum_abs_err = 0.0;

    for (int r = 0; r < rows; ++r) {
        double row_sum = 0.0;

        for (int c = 0; c < cols; ++c) {
            const size_t i = (size_t) r * cols + c;

            const double diff = (double) dst[i] - (double) ref[i];
            const double abs_err = diff < 0.0 ? -diff : diff;

            if (abs_err > max_abs_err) max_abs_err = abs_err;
            row_sum += (double) dst[i];
        }

        const double sum_diff = row_sum - 1.0;
        const double sum_abs_err = sum_diff < 0.0 ? -sum_diff : sum_diff;

        if (sum_abs_err > max_row_sum_abs_err) {
            max_row_sum_abs_err = sum_abs_err;
        }
    }

    std::printf("SOFTMAX_ROWS_F32: max_abs_err=%.9g row_sum_abs=%.9g\n",
        max_abs_err, max_row_sum_abs_err);

    if (max_abs_err > 2e-5 || max_row_sum_abs_err > 2e-5) {
        std::fprintf(stderr, "SOFTMAX_ROWS_F32 FAIL\n");
        return false;
    }

    std::printf("SOFTMAX_ROWS_F32 PASS\n");
    return true;
}

// ---------------------------------------------------------------------
// Q8_0 MUL_MAT
// ---------------------------------------------------------------------

static void fill_q8_inputs(std::vector<float> & A, std::vector<float> & x, int rows, int cols) {
    for (int r = 0; r < rows; ++r) {
        for (int c = 0; c < cols; ++c) {
            const int v = (r * 17 + c * 31 + 7) % 251;
            A[(size_t) r * cols + c] = ((float) v - 125.0f) * 0.003f;
        }
    }

    for (int c = 0; c < cols; ++c) {
        const int v = (c * 13 + 5) % 197;
        x[c] = ((float) v - 98.0f) * 0.004f;
    }
}

static void pack_q8_0(
    const std::vector<float> & A,
    std::vector<ggml_cuda8_q8_0_block> & Aq,
    int rows,
    int cols
) {
    const int blocks_per_row =
        (cols + GGML_CUDA8_QK8_0 - 1) / GGML_CUDA8_QK8_0;

    Aq.resize((size_t) rows * blocks_per_row);

    for (int r = 0; r < rows; ++r) {
        for (int ib = 0; ib < blocks_per_row; ++ib) {
            ggml_cuda8_q8_0_block & block =
                Aq[(size_t) r * blocks_per_row + ib];

            float max_abs = 0.0f;

            for (int k = 0; k < GGML_CUDA8_QK8_0; ++k) {
                const int col = ib * GGML_CUDA8_QK8_0 + k;
                float v = 0.0f;

                if (col < cols) {
                    v = A[(size_t) r * cols + col];
                }

                max_abs = max_abs > std::fabs(v) ? max_abs : std::fabs(v);
            }

            float d = 0.0f;
            float id = 0.0f;

            if (max_abs > 0.0f) {
                d = max_abs / 127.0f;
                id = 127.0f / max_abs;
            }

            block.d = fp32_to_fp16_bits(d);

            for (int k = 0; k < GGML_CUDA8_QK8_0; ++k) {
                const int col = ib * GGML_CUDA8_QK8_0 + k;
                float v = 0.0f;

                if (col < cols) {
                    v = A[(size_t) r * cols + col];
                }

                int q = 0;

                if (max_abs > 0.0f) {
                    q = (int) std::floor(v * id + (v >= 0.0f ? 0.5f : -0.5f));
                }

                if (q > 127) q = 127;
                if (q < -127) q = -127;

                block.qs[k] = (int8_t) q;
            }
        }
    }
}

static void cpu_q8_ref(
    const std::vector<ggml_cuda8_q8_0_block> & Aq,
    const std::vector<float> & x,
    std::vector<float> & y,
    int rows,
    int cols
) {
    const int blocks_per_row =
        (cols + GGML_CUDA8_QK8_0 - 1) / GGML_CUDA8_QK8_0;

    for (int r = 0; r < rows; ++r) {
        const ggml_cuda8_q8_0_block * row_blocks =
            &Aq[(size_t) r * blocks_per_row];

        float sum = 0.0f;

        for (int ib = 0; ib < blocks_per_row; ++ib) {
            const ggml_cuda8_q8_0_block & block = row_blocks[ib];
            const float d = fp16_bits_to_fp32(block.d);

            const int base_col = ib * GGML_CUDA8_QK8_0;
            float block_sum = 0.0f;

            for (int k = 0; k < GGML_CUDA8_QK8_0; ++k) {
                const int col = base_col + k;

                if (col < cols) {
                    block_sum += ((float) block.qs[k]) * x[col];
                }
            }

            sum += d * block_sum;
        }

        y[r] = sum;
    }
}

static bool test_q8_mul_mat(ggml_cuda8_context * ctx) {
    std::printf("\n[MUL_MAT_Q8_0xF32_VEC]\n");

    const int rows = 256;
    const int cols = 128;

    std::vector<float> A((size_t) rows * cols);
    std::vector<float> x((size_t) cols);
    std::vector<float> y((size_t) rows, 0.0f);
    std::vector<float> ref((size_t) rows, 0.0f);
    std::vector<ggml_cuda8_q8_0_block> Aq;

    fill_q8_inputs(A, x, rows, cols);
    pack_q8_0(A, Aq, rows, cols);
    cpu_q8_ref(Aq, x, ref, rows, cols);

    ggml_tensor t_Aq;
    ggml_tensor t_x;
    ggml_tensor t_y;

    setup_q8_0_matrix_2d(t_Aq, cols, rows, &Aq[0]);
    setup_f32_vector(t_x, cols, &x[0]);
    setup_f32_vector(t_y, rows, &y[0]);

    const int op = GGML_CUDA8_OP_MUL_MAT_Q8_0_F32_VEC;

    if (!ggml_cuda8_dispatch_supported(ctx, op, &t_Aq, &t_x, &t_y)) {
        std::fprintf(stderr, "MUL_MAT_Q8_0xF32_VEC unsupported\n");
        return false;
    }

    if (ggml_cuda8_dispatch_execute(ctx, op, &t_Aq, &t_x, &t_y) != 0) {
        std::fprintf(stderr, "MUL_MAT_Q8_0xF32_VEC execute failed\n");
        return false;
    }

    if (!check_close(y, ref, 2e-4, 2e-4, "MUL_MAT_Q8_0xF32_VEC")) {
        return false;
    }

