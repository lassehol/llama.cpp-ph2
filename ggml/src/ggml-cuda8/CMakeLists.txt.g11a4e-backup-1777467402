    ggml-cuda8-add.cu
    ggml-cuda8-scalar.cpp
    ggml-cuda8-scalar.cu
    ggml-cuda8-reduce.cpp
    ggml-cuda8-reduce.cu
    ggml-cuda8-softmax.cpp
    ggml-cuda8-softmax.cu
)

target_link_libraries(ggml-cuda8-kernels
    ${CUDA_LIBRARIES}
)

