#!/usr/bin/env python3
# G23C_precommit_sanity.py
#
# G23C: pre-commit sanity for the CUDA8 G23B checkpoint.
#
# Checks:
#   - run_g11_regression.sh is not literal-\n corrupted
#   - G17-G23 quantized graph-builder targets appear exactly once
#   - final success label is CUDA8 G23B regression SUCCESS
#   - README G23 status exists
#   - G23A source/CMake target exists
#
# Python 3.5-compatible.

import os
import sys

ROOT = "/workspace/notebooks/llama.cpp-ph2"
REG = os.path.join(ROOT, "run_g11_regression.sh")
README = os.path.join(ROOT, "ggml/src/ggml-cuda8/README.md")
CMAKE = os.path.join(ROOT, "ggml/src/ggml-cuda8/CMakeLists.txt")
G23_SRC = os.path.join(ROOT, "ggml/src/ggml-cuda8/ggml-cuda8-ggml-backend-graph-builder-q8_0-residual-add-softmax-sumrows-smoke.cpp")

TARGETS = [
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-mmv-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-add-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-mul-add-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-mul-add-softmax-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-mul-add-softmax-sumrows-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-residual-add-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-residual-add-softmax-smoke",
    "ggml-cuda8-ggml-backend-graph-builder-q8_0-residual-add-softmax-sumrows-smoke",
]


def read_file(path):
    with open(path, "r") as f:
        return f.read()


def fail(msg):
    sys.stderr.write("G23C sanity FAIL: " + msg + "\n")
    sys.exit(1)


def require_file(path):
    if not os.path.exists(path):
        fail("missing file: " + path)


def check_regression_script():
    require_file(REG)
    data = read_file(REG)

    if not data.startswith("#!/usr/bin/env bash\nset -euo pipefail\n"):
        fail("run_g11_regression.sh header is not clean real-newline bash header")

    if "\\n" in data:
        fail("run_g11_regression.sh contains literal backslash-n text")

    if "\nn#" in data or data.startswith("n#"):
        fail("run_g11_regression.sh contains stray n# marker")

    if "\\\n# G17" in data:
        fail("run_g11_regression.sh contains line-continuation before G17 block")

    if 'echo "CUDA8 G23B regression SUCCESS"' not in data:
        fail("missing CUDA8 G23B success label")

    for target in TARGETS:
        run_line = "run_target " + target + " " + target
        count = data.count(run_line)
        if count != 1:
            fail("target line count for {} is {}, expected 1".format(target, count))

    print("run_g11_regression.sh integrity PASS")


def check_readme():
    require_file(README)
    data = read_file(README)

    required = [
        "<!-- G23_STATUS_START -->",
        "<!-- G23_STATUS_END -->",
        "G23 status: real GGML graph-builder quantized residual softmax + sum_rows coverage",
        "G23A",
        "G23B",
        "GGML_OP_MUL_MAT",
        "GGML_OP_ADD",
        "GGML_OP_SOFT_MAX",
        "GGML_OP_SUM_ROWS",
        "GGML_CUDA8_OP_MUL_MAT_Q8_0_F32_VEC",
        "GGML_CUDA8_OP_ADD_F32",
        "GGML_CUDA8_OP_SOFTMAX_ROWS_F32",
        "GGML_CUDA8_OP_REDUCE_SUM_ROWS_F32",
    ]

    for token in required:
        if token not in data:
            fail("README missing token: " + token)

    print("README G23 status PASS")


def check_g23_files():
    require_file(CMAKE)
    require_file(G23_SRC)

    cmake = read_file(CMAKE)
    src = read_file(G23_SRC)

    target = "ggml-cuda8-ggml-backend-graph-builder-q8_0-residual-add-softmax-sumrows-smoke"

    if target not in cmake:
        fail("CMakeLists.txt missing G23A target")

    required_src_tokens = [
        "ggml_mul_mat",
        "ggml_add",
        "ggml_soft_max",
        "ggml_sum_rows",
        "MUL_MAT_Q8_0xF32_VEC",
        "RESIDUAL_ADD_F32",
        "SOFTMAX_ROWS_F32",
        "REDUCE_SUM_ROWS_F32",
        "residual branch isolation PASS",
    ]

    for token in required_src_tokens:
        if token not in src:
            fail("G23A source missing token: " + token)

    print("G23A source/CMake presence PASS")


def main():
    check_regression_script()
    check_readme()
    check_g23_files()
    print("G23C pre-commit metadata sanity PASS")


if __name__ == "__main__":
    main()
